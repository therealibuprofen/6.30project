{
  "experiment": "mamba_visual_binary_v1",
  "model": "spatial_mamba",
  "sessions": ["626", "628", "708", "709", "710", "807", "813", "817", "822"],
  "task": "binary",
  "input_shape": [4, 128, 501],
  "seeds": [0, 1, 2],
  "max_folds": 10,
  "spatial_scan": "bidirectional shared-weight row-major",
  "model_config": {
    "stem_channels": [16, 32, 64],
    "adaptive_pool": [8, 32],
    "spatial_tokens": 256,
    "d_model": 64,
    "d_state": 16,
    "d_conv": 4,
    "expand": 2,
    "spatial_mamba_layers": 2,
    "temporal_heads": 4,
    "temporal_layers": 1,
    "temporal_dim_feedforward": 128,
    "dropout": 0.25,
    "n_classes": 2
  },
  "training": {
    "optimizer": "AdamW",
    "lr": 0.001,
    "weight_decay": 0.001,
    "batch_size": 16,
    "max_epochs": 40,
    "epoch_selection": "fixed_40_no_validation_or_test_selection",
    "oom_policy": "stop_and_report_without_automatic_batch_change"
  },
  "normalization": "arcsinh_then_train_pixel_zscore_train_fold_only",
  "primary_metric": "OOF_balanced_accuracy"
}
