{
  "output_version": "cycle_consistent_temporal1d_v1",
  "sessions": ["626", "628", "708", "709", "710", "807", "813", "817", "822"],
  "strong_sessions": ["708", "709", "710"],
  "weak_sessions": ["626", "628", "807", "813", "817", "822"],
  "task": "binary",
  "class_mapping": {"0": "no_stimulus", "1": "stimulus"},
  "input_protocol": "clean4",
  "input_variants": ["raw", "cycle_consistent"],
  "seeds": [0, 1, 2],
  "max_folds": 10,
  "normalization": "arcsinh_then_outer_train_fold_pixel_zscore",
  "model": "cnn2d_temporal1d",
  "classifier_input_embedding_dimension": 64,
  "cycle_consistency": {
    "positive_pair": "same_block_identity_and_different_training_cycle",
    "unique_pair_rule": "upper_triangle_i_less_than_j",
    "embedding_normalization": "L2",
    "loss": "mean(1-cosine_similarity)",
    "lambda_consistency": 0.1,
    "lambda_search": false,
    "negatives": false,
    "projection_head": false,
    "pair_scope": "current_training_minibatch_only",
    "zero_pair_batch_behavior": "classification_update_with_zero_consistency_loss",
    "test_block_identity_used": false,
    "test_embedding_used": false
  },
  "optimizer": "adamw",
  "learning_rate": 0.001,
  "weight_decay": 0.001,
  "batch_size": 16,
  "epochs": 40,
  "dropout": 0.25,
  "loss": "cross_entropy_plus_fixed_cycle_consistency",
  "early_stopping": false,
  "primary_metric": "OOF balanced_accuracy",
  "historical_raw_reused": false,
  "automatic_next_stage": false
}
