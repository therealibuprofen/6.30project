{
  "output_version": "response_weighted_temporal1d_v1",
  "sessions": ["626", "628", "708", "709", "710", "807", "813", "817", "822"],
  "strong_sessions": ["708", "709", "710"],
  "weak_sessions": ["626", "628", "807", "813", "817", "822"],
  "task": "binary",
  "class_mapping": {"0": "no_stimulus", "1": "stimulus"},
  "input_protocol": "clean4",
  "input_variants": ["raw", "response_weighted"],
  "seeds": [0, 1, 2],
  "max_folds": 10,
  "normalization": "arcsinh_then_outer_train_fold_pixel_zscore",
  "response_map": {
    "fit_scope": "outer_training_cycles_only",
    "cycle_contrast": "0.5*(G+D)-0.5*(S+T)",
    "response_score": "abs(mean_cycle(C))/(std_cycle(C,ddof=0)+1e-6)",
    "rank_method": "average",
    "percentile": "(rank-1)/(n_pixels-1)",
    "weight": "0.5+percentile",
    "weight_range": [0.5, 1.5],
    "apply_after_normalization": true,
    "same_weight_for_train_and_test": true,
    "full_session_glm_allowed": false
  },
  "model": "cnn2d_temporal1d",
  "optimizer": "adamw",
  "learning_rate": 0.001,
  "weight_decay": 0.001,
  "batch_size": 16,
  "epochs": 40,
  "dropout": 0.25,
  "loss": "cross_entropy",
  "early_stopping": false,
  "primary_metric": "OOF balanced_accuracy",
  "historical_raw_reused": false,
  "automatic_next_stage": false
}
